# boxd API key — create with: boxd auth keys create software-factory
BOXD_API_KEY=bxd_...

# GitHub token. Optional locally: falls back to `gh auth token`.
# Required when running on a server, and the same value is handed to every run VM as
# GH_TOKEN — so one credential covers the control plane's API calls and everything the agent
# does in the VM. It needs `repo` *and* `workflow`: without `workflow`, GitHub rejects the
# whole push the moment any commit in it touches .github/workflows/*, and a read-only token
# passes preflight's other checks and then fails at the first push.
GITHUB_TOKEN=

# Claude auth injected into every run so the agent uses a durable credential instead of the
# golden's OAuth login (which expires and can't run unattended). Set ONE:
#   CLAUDE_CODE_OAUTH_TOKEN — Claude subscription; generate with `claude setup-token`
#   ANTHROPIC_API_KEY       — console/API billing
# Strongly recommended for autonomous operation. If unset, the agent relies on the golden login.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Reasoning effort for the agent (low/medium/high). Spend scales with turn count and context
# size, not any single call; `medium` buys most of `high`'s quality for materially fewer
# tokens. Raise it if issues start coming back underdone.
FACTORY_AGENT_EFFORT=medium

# Auto-merge (squash) a run's PR on success, so the next issue in a sequential backlog
# branches from a main that already contains the previous issue's work. Off by default.
FACTORY_AUTO_MERGE=0

# Wait for the PR's check runs to pass before auto-merging. The GitHub merge API waits for
# nothing by itself: with this off, a PR is merged seconds after it is opened and CI ends up
# reporting on a commit that is already in main. Set to 0 only to observe raw auto-merge
# behaviour deliberately.
FACTORY_MERGE_REQUIRE_CHECKS=1
# How long to wait for those checks (seconds) before giving up and leaving the PR open.
FACTORY_MERGE_CHECK_TIMEOUT=900

# After a build run opens a PR, run a second agent that checks it against the issue's
# acceptance criteria before anything merges. Only applies to issues that carry a
# machine-readable criteria block (see the factory-compose skill) — an issue without one has
# nothing to check, so its PR takes the old path instead of being reviewed against a guess.
FACTORY_REVIEW=1
# How many times a review may send an issue back before it stops and asks for a human.
FACTORY_MAX_REVIEW_CYCLES=2

# The goal loop. A watched repo can carry a goal — prose describing the endstate of the
# project, set through the UI or PATCH /api/repos/{owner}/{name}. With this on, a repo whose
# queue runs dry and whose goal is active gets a plan run: an agent on a fresh VM that reads
# the repo, compares it against the goal, and either files the next batch of `agent:queued`
# issues (factory-compose format, so they carry executable acceptance criteria) or declares
# the goal met with evidence. Off by default, deliberately: a planner that files issues is a
# factory that spends money without being asked, and switching that on is a decision, not a
# default.
FACTORY_PLAN=0
# Seconds between plan dispatches for one repo. The backstop against a tight loop of broken
# plan runs; stamped at dispatch so crashes count against it too.
FACTORY_PLAN_COOLDOWN=900
# Consecutive fruitless plan runs (crashed, no verdict, or claimed issues that never appeared
# queued) before the repo's goal is marked `stalled` for a human. Same number and same
# reasoning as FACTORY_MAX_REVIEW_CYCLES: a third identical failure means the goal is wrong.
FACTORY_PLAN_MAX_STALLS=2
# The most issues one plan run may file. Small on purpose — the factory builds sequentially
# and plans again when these are done, so each pass reads the code as it actually is.
FACTORY_PLAN_MAX_ISSUES=6

# The improvement loop. Periodically an agent reads what the last few issues cost in
# rejections and failures, grades whatever it changed last time, and files issues proposing
# changes to a repo's `.mem/`, its `.factory.md`, or its own `.claude/skills/`.
#
# Off by default: it is the one part of this system that edits its own inputs.
FACTORY_LEARN=0
# Issues a repo must finish before its next learning run. Volume rather than a clock — a repo
# that shipped nothing has produced no new evidence to read.
FACTORY_LEARN_EVERY=5
# How far back the digest looks. Wider than the trigger on purpose: a change is judged against
# what happened before it, so the window has to contain both sides.
FACTORY_LEARN_WINDOW_DAYS=30
# Proposals one learning run may file. Small deliberately — the scarce resource is the review
# capacity to check them and the context budget to hold what gets merged.
FACTORY_LEARN_MAX_PROPOSALS=3
# Whether a filed proposal is labelled `agent:queued`, which is what makes the factory build
# it. Off means the loop still runs, still reasons, still files fully-formed issues, and stops
# one step short of changing anything. Start here: read a cycle or two before turning it on.
FACTORY_LEARN_AUTOQUEUE=0

# Where a run clones the repo it was assigned, inside the VM. Leave empty for $HOME/work.
# A golden is an agent image now: it carries no repo, and each run clones the one it is for.
FACTORY_WORKDIR=

# A checkout to reuse instead of cloning, and only when it holds the repo the run was
# assigned. Goldens built before they became repo-agnostic carry one checkout at this path;
# this is the rollback for that migration and goes away with it. Leave empty on a new setup.
FACTORY_REPO_DIR=/home/boxd/repo

# How many runs may execute at once. Keep well under your boxd machine quota.
FACTORY_MAX_CONCURRENT=3

# How many goldens may be warmed at once. Its own budget rather than a share of
# FACTORY_MAX_CONCURRENT: connecting three repos starts three warm-ups, and they must never be
# able to take every build slot.
FACTORY_MAX_PROVISION=2

# How long to wait for boxd to finish *writing* a snapshot, in seconds, and how often to ask.
# The SDK's snapshots.create returns when the capture is queued, not when it is written, and
# destroying the machine underneath a queued capture aborts it permanently — leaving a name
# that is `pending` forever with nothing behind it to boot. Past this timeout the half-written
# snapshot is deleted rather than left in the fleet looking like progress.
FACTORY_CAPTURE_TIMEOUT=1200
FACTORY_CAPTURE_POLL=5

# Hard ceiling on a single agent run, in seconds. Successful runs have taken 27-53 minutes,
# so this is headroom over the observed worst case rather than a target.
FACTORY_RUN_TIMEOUT=5400

# What one run may spend before it is aborted, in USD. Checked at every turn boundary against
# the derived cost of the rows already written — a threshold on a number that exists, not an
# estimate. A run stopped here is never retried: it was stopped because it was spending
# without converging, and two more attempts would make the real ceiling three times this.
# 0 switches it off. Roughly twice the measured cost of a shipped issue ($11.44 over 47 runs).
FACTORY_MAX_RUN_COST=25
# What one repo's autonomous loops may spend in a UTC day, in USD. 0 switches it off.
#
# This is the ceiling that bounds a *loop*, and the per-run one does not imply it. The planner
# files up to FACTORY_PLAN_MAX_ISSUES issues, each builds for well under the per-run ceiling,
# the queue drains, and it plans again — nothing in that cycle is individually expensive and
# nothing in it terminates except an agent judging the goal met.
#
# It stops the plan and learning loops starting work. It never refuses a queued issue: that is
# work you asked for, and a factory that stops building your backlog because a planner had an
# expensive morning is one you switch the ceiling off in. The sum still counts every kind, so
# builds the loops caused push the day toward the ceiling — the queue drains and stops
# growing. A run started by hand through the API is not checked at all.
#
# 100 is a starting point, not a measured number — set it to what a bad day may cost you.
FACTORY_MAX_REPO_DAILY_COST=100

# How long one shell command may run inside the VM before the agent's own tooling moves it to
# the background, and the longest timeout the agent may request for a single command. Well
# above any legitimate command (the longest observed build was 153s): a backgrounded command
# is one the agent then waits on forever, since `claude -p` never delivers the notification
# it is waiting for. A genuinely stuck command is caught by FACTORY_RUN_TIMEOUT instead.
FACTORY_BASH_TIMEOUT=600
FACTORY_BASH_MAX_TIMEOUT=1800

# Destroy any run VM this many seconds after creation, even if we crash.
# Last-resort safety net against orphans; set above FACTORY_RUN_TIMEOUT.
FACTORY_AUTO_DESTROY=7200

# The boxd account's concurrent-machine cap. Checked before a run provisions, because past it
# boxd refuses the create and the run that finds out is the one that dies. Counts the whole
# fleet — goldens still held as machines, a control plane, a scratch VM — which is what makes
# it different from FACTORY_MAX_CONCURRENT. A full fleet is swept for orphans before the run
# gives up. Set to 0 to switch the check off.
FACTORY_MAX_MACHINES=20

# How often to sweep the fleet against the runs table, in seconds: destroy run VMs with no
# run behind them, and fail runs whose VM has vanished. 0 switches the sweep off, leaving
# FACTORY_AUTO_DESTROY as the only thing reclaiming a leaked machine.
FACTORY_RECONCILE_INTERVAL=300

# Keep the VM alive after a failed run so you can SSH in and look around.
FACTORY_KEEP_FAILED=0

# Retry a failed issue up to this many attempts total (1 = no retry). Each retry is a fresh
# VM on the same branch, with the previous attempt's log fed to the agent as context.
FACTORY_MAX_ATTEMPTS=3
# In a sequential project an issue that stopped for a human blocks the ones after it: when
# on, the poller stops dispatching a repo that has any open agent:failed (out of retries) or
# agent:blocked (review would not pass) issue, until a human clears it. Either state means
# the work never reached the base branch, so the next issue would build on a base missing it.
# Set to 0 if a repo's issues are independent of each other.
FACTORY_HALT_ON_FAILURE=1

# Issue polling. Repos to watch, comma-separated. This is the *seed* for the register, not
# the register: repos live in the database now and are connected through `POST /api/repos`,
# so what is listed here is added on boot if it is not already there and never removed.
# Taking an entry out does not unwatch that repo — `DELETE /api/repos/<owner>/<name>` does.
# Leave empty on a new deployment and connect repos through the interface.
#
# Drop the `agent:queued` label on an open issue to enqueue it; issues are claimed lowest
# number first, one at a time per repo.
#
# An entry is `owner/repo`. The golden it boots is derived from that name: the snapshot
# `golden-<owner-repo>` if the repo has been warmed into one, else the `golden-copy` base
# image, which every repo can boot and which installs the repo for itself. So a repo needs no
# configuration beyond being listed, and connecting one never waits on provisioning.
#
# A legacy `owner/repo=agent` entry still parses — the agent half is dropped. Nothing selects
# a snapshot by agent any more; which agent an image runs is what the image announces in its
# own manifest.
#   FACTORY_REPOS=acme/api,acme/pi-firmware
FACTORY_REPOS=
# Turn polling off without clearing FACTORY_REPOS.
FACTORY_POLL=1
# Seconds between polls.
FACTORY_POLL_INTERVAL=30
# Seconds between re-listing the golden snapshots. One API call, no VM, so it can be
# frequent: this is how an agent built by hand becomes dispatchable. 0 switches it off.
FACTORY_AGENT_REFRESH=300

# How much the control plane says about itself: the poller's dispatches and halts, the golden
# refresh, the fleet reconciler. Goes to stdout, which systemd appends to var/uvicorn.log.
# DEBUG also turns on the HTTP and database libraries, which are noisy and rarely the question.
FACTORY_LOG_LEVEL=INFO

# Public URL of this control plane. Only used to link runs from issue comments.
FACTORY_BASE_URL=

# Login that gates the whole UI + API. A single shared account. The password is only ever
# checked server-side — it never ships to the browser. Set both in your own .env; never commit
# a real password to this file, which is public to anyone who can read the repo.
FACTORY_AUTH_EMAIL=you@example.com
FACTORY_AUTH_PASSWORD=change-me
# Optional: signing key for session cookies. If unset it is derived from the password (stable
# across restarts, rotates when the password changes). Set a random value to pin it explicitly.
FACTORY_SECRET_KEY=
