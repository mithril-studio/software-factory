# boxd API key — create with: boxd auth keys create software-factory
BOXD_API_KEY=bxd_...

# GitHub token. Optional locally: falls back to `gh auth token`.
# Required when running on a server. Needs repo scope.
GITHUB_TOKEN=

# Machine forked for every run. Must have the repo cloned, deps installed,
# `claude` authenticated, and skills/memory installed.
FACTORY_GOLDEN=golden-example

# Path inside the VM where the repo lives.
FACTORY_REPO_DIR=/home/boxd/repo

# How many runs may execute at once. Keep well under your boxd machine quota.
FACTORY_MAX_CONCURRENT=3

# Hard ceiling on a single agent run, in seconds.
FACTORY_RUN_TIMEOUT=3600

# Destroy any run VM this many seconds after creation, even if we crash.
# Safety net against orphans; set above FACTORY_RUN_TIMEOUT.
FACTORY_AUTO_DESTROY=7200

# Keep the VM alive after a failed run so you can SSH in and look around.
FACTORY_KEEP_FAILED=0

# Retry a failed issue up to this many attempts total (1 = no retry). Each retry is a fresh
# VM on the same branch, with the previous attempt's log fed to the agent as context.
FACTORY_MAX_ATTEMPTS=3
# In a sequential project a permanently-failed issue blocks the ones after it: when on, the
# poller stops dispatching a repo that has any open agent:failed issue until a human clears
# it. Set to 0 if a repo's issues are independent of each other.
FACTORY_HALT_ON_FAILURE=1

# Issue polling. Repos the poller watches, comma-separated. Leave empty to run
# UI-only (no polling). Drop the `agent:queued` label on an open issue to enqueue it;
# issues are claimed lowest number first, one at a time per repo.
FACTORY_REPOS=
# Turn polling off without clearing FACTORY_REPOS.
FACTORY_POLL=1
# Seconds between polls.
FACTORY_POLL_INTERVAL=30

# Public URL of this control plane. Only used to link runs from issue comments.
FACTORY_BASE_URL=
