# boxd API key — create with: boxd auth keys create software-factory
BOXD_API_KEY=bxd_...

# GitHub token. Optional locally: falls back to `gh auth token`. Required on a server.
# The same value is handed to every run VM as GH_TOKEN, so it covers the control plane's API
# calls and the agent's clone, push and `gh pr create`. It needs `repo` *and* `workflow`:
# without `workflow`, GitHub rejects any push that touches .github/workflows/*.
GITHUB_TOKEN=

# Claude auth injected into every run, so the agent uses a durable credential instead of the
# golden's OAuth login (which expires). Set ONE:
#   CLAUDE_CODE_OAUTH_TOKEN — Claude subscription; generate with `claude setup-token`
#   ANTHROPIC_API_KEY       — console/API billing
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Reasoning effort for the agent (low/medium/high).
FACTORY_AGENT_EFFORT=medium

# Where every pull request goes. Created from the repo's default branch on the first run if it
# does not exist. A repo can point elsewhere from the Projects page.
FACTORY_TARGET_BRANCH=test

# Wait for the factory's open PR into the target branch to be merged or closed before starting
# the next issue, so dependent issues build on each other. Re-queuing an issue to address
# feedback on its own open PR is always allowed. Set 0 if a repo's issues are independent.
FACTORY_SEQUENTIAL=1

# Soft budget per run, in euros. A run that passes it is flagged in the UI and in the issue
# comment, and keeps running. Telemetry prices in USD; FACTORY_USD_PER_EUR converts.
FACTORY_RUN_BUDGET_EUR=100
FACTORY_USD_PER_EUR=1.15

# Every VM this control plane creates is named with this prefix, and the reconciler only ever
# deletes machines carrying it. Two control planes on one boxd account need different ones.
FACTORY_VM_PREFIX=job-

# How many runs may execute at once, across all repos. One per repo at a time regardless.
FACTORY_MAX_CONCURRENT=3

# Hard ceiling on a single run, in seconds, including provisioning.
FACTORY_RUN_TIMEOUT=5400

# How long one shell command may run inside the VM before the agent's tooling backgrounds it,
# and the longest timeout the agent may request. Headless Claude Code never delivers the
# notification a backgrounded command waits for, so keep these above any real build.
FACTORY_BASH_TIMEOUT=600
FACTORY_BASH_MAX_TIMEOUT=1800

# Destroy any run VM this many seconds after creation, even if the control plane dies.
FACTORY_AUTO_DESTROY=7200

# The boxd account's machine cap. Checked before provisioning; the fleet is swept for orphans
# before a run gives up. 0 switches the check off.
FACTORY_MAX_MACHINES=20

# How often to sweep the fleet against the runs table, in seconds. 0 switches it off.
FACTORY_RECONCILE_INTERVAL=300

# Keep a failed run's VM alive so you can SSH in and look around.
FACTORY_KEEP_FAILED=0

# Where a run clones its repo inside the VM. Empty means $HOME/work.
FACTORY_WORKDIR=

# Repos to watch, comma-separated. Only seeds an empty register on first boot; after that
# the Projects page owns the list and this is ignored. Leave empty on a new deployment.
#   FACTORY_REPOS=acme/api,acme/web
FACTORY_REPOS=
# Turn polling off without clearing the register.
FACTORY_POLL=1
# Seconds between polls.
FACTORY_POLL_INTERVAL=30

FACTORY_LOG_LEVEL=INFO

# Public URL of this control plane. Used to link runs from issue comments.
FACTORY_BASE_URL=

# Login that gates the whole UI + API. A single shared account, checked server-side only.
# Set both in your own .env; never commit a real password to this file.
FACTORY_AUTH_EMAIL=you@example.com
FACTORY_AUTH_PASSWORD=change-me
# Optional signing key for session cookies. Derived from the password if unset.
FACTORY_SECRET_KEY=
