# boxd API key — create with: boxd auth keys create software-factory
BOXD_API_KEY=bxd_...

# GitHub token. Optional locally: falls back to `gh auth token`.
# Required when running on a server. Needs repo scope.
GITHUB_TOKEN=

# Claude auth injected into every run so the agent uses a durable credential instead of the
# golden's OAuth login (which expires and can't run unattended). Set ONE:
#   CLAUDE_CODE_OAUTH_TOKEN — Claude subscription; generate with `claude setup-token`
#   ANTHROPIC_API_KEY       — console/API billing
# Strongly recommended for autonomous operation. If unset, the agent relies on the golden login.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=

# Auto-merge (squash) a run's PR on success, so the next issue in a sequential backlog
# branches from a main that already contains the previous issue's work. Off by default.
FACTORY_AUTO_MERGE=0

# Wait for the PR's check runs to pass before auto-merging. The GitHub merge API waits for
# nothing by itself: with this off, a PR is merged seconds after it is opened and CI ends up
# reporting on a commit that is already in main. Set to 0 only to observe raw auto-merge
# behaviour deliberately.
FACTORY_MERGE_REQUIRE_CHECKS=1
# How long to wait for those checks (seconds) before giving up and leaving the PR open.
FACTORY_MERGE_CHECK_TIMEOUT=900

# After a build run opens a PR, run a second agent that checks it against the issue's
# acceptance criteria before anything merges. Only applies to issues that carry a
# machine-readable criteria block (see the factory-compose skill) — an issue without one has
# nothing to check, so its PR takes the old path instead of being reviewed against a guess.
FACTORY_REVIEW=1
# How many times a review may send an issue back before it stops and asks for a human.
FACTORY_MAX_REVIEW_CYCLES=2

# Where a run clones the repo it was assigned, inside the VM. Leave empty for $HOME/work.
# A golden is an agent image now: it carries no repo, and each run clones the one it is for.
FACTORY_WORKDIR=

# A checkout to reuse instead of cloning, and only when it holds the repo the run was
# assigned. Goldens built before they became repo-agnostic carry one checkout at this path;
# this is the rollback for that migration and goes away with it. Leave empty on a new setup.
FACTORY_REPO_DIR=/home/boxd/repo

# How many runs may execute at once. Keep well under your boxd machine quota.
FACTORY_MAX_CONCURRENT=3

# Hard ceiling on a single agent run, in seconds. Successful runs have taken 27-53 minutes,
# so this is headroom over the observed worst case rather than a target.
FACTORY_RUN_TIMEOUT=5400

# How long one shell command may run inside the VM before the agent's own tooling moves it to
# the background, and the longest timeout the agent may request for a single command. Well
# above any legitimate command (the longest observed build was 153s): a backgrounded command
# is one the agent then waits on forever, since `claude -p` never delivers the notification
# it is waiting for. A genuinely stuck command is caught by FACTORY_RUN_TIMEOUT instead.
FACTORY_BASH_TIMEOUT=600
FACTORY_BASH_MAX_TIMEOUT=1800

# Destroy any run VM this many seconds after creation, even if we crash.
# Safety net against orphans; set above FACTORY_RUN_TIMEOUT.
FACTORY_AUTO_DESTROY=7200

# Keep the VM alive after a failed run so you can SSH in and look around.
FACTORY_KEEP_FAILED=0

# Retry a failed issue up to this many attempts total (1 = no retry). Each retry is a fresh
# VM on the same branch, with the previous attempt's log fed to the agent as context.
FACTORY_MAX_ATTEMPTS=3
# In a sequential project a permanently-failed issue blocks the ones after it: when on, the
# poller stops dispatching a repo that has any open agent:failed issue until a human clears
# it. Set to 0 if a repo's issues are independent of each other.
FACTORY_HALT_ON_FAILURE=1

# Issue polling. Repos the poller watches, comma-separated. Leave empty to run
# UI-only (no polling). Drop the `agent:queued` label on an open issue to enqueue it;
# issues are claimed lowest number first, one at a time per repo.
#
# An entry is `owner/repo` or `owner/repo=agent`, where `agent` names the agent that takes
# that repo's issues — not a machine. The golden it boots is derived from the name: the
# snapshot `golden-<agent>--<owner-repo>` if that repo has been warmed into one, else the
# bare `golden-<agent>` image. So there is no per-agent variable to add here; a fourth agent
# needs a snapshot and nothing else.
#   FACTORY_REPOS=acme/api,acme/pi-firmware=pi
FACTORY_REPOS=
# The agent for a repo that names none of its own.
FACTORY_AGENT_DEFAULT=claude
# Turn polling off without clearing FACTORY_REPOS.
FACTORY_POLL=1
# Seconds between polls.
FACTORY_POLL_INTERVAL=30
# Seconds between re-listing the golden snapshots. One API call, no VM, so it can be
# frequent: this is how an agent built by hand becomes dispatchable. 0 switches it off.
FACTORY_AGENT_REFRESH=300

# Public URL of this control plane. Only used to link runs from issue comments.
FACTORY_BASE_URL=

# Login that gates the whole UI + API. A single shared account. The password is only ever
# checked server-side — it never ships to the browser. Set both in your own .env; never commit
# a real password to this file, which is public to anyone who can read the repo.
FACTORY_AUTH_EMAIL=you@example.com
FACTORY_AUTH_PASSWORD=change-me
# Optional: signing key for session cookies. If unset it is derived from the password (stable
# across restarts, rotates when the password changes). Set a random value to pin it explicitly.
FACTORY_SECRET_KEY=
